# Optional — only needed for the /career-agent questionnaire's email / LINE / Sheet
# features. The app works without them (the API routes skip gracefully).
# Copy to .env.local and fill in to enable.

## Email (SMTP) — enables /api/send-results
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=                 # e.g. "Career Agent <no-reply@yourdomain.com>"
RESULT_TO=                 # comma-separated recipients
SEND_TO_APPLICANT=false    # also email the applicant if they provided one

## LINE Notify token — enables /api/send-line (note: LINE Notify was shut down Mar 2025)
LINE_NOTIFY_TOKEN=

## Optional Google Apps Script URL — client posts responses to a Google Sheet
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_URL=
